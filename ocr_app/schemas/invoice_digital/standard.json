{
  "standard": {
    "code": "国家税务总局公告 2024 年第 11 号",
    "title": "全面数字化电子发票（数电票）票面基本内容",
    "source_url": "https://www.chinatax.gov.cn/",
    "license": "仅作字段取舍参考；公告与票样原文版权归发布方所有，未整份内嵌",
    "note": "数电票删除发票代码、密码区、地址电话栏、银行账号栏，号码改 20 位。本文件只描述输出数据模型；定位策略见 schema.yaml。"
  },
  "removed_fields": [
    "header.invoice_code（发票代码）",
    "buyer.address_phone（地址电话栏）",
    "buyer.bank_account（开户行及账号栏）",
    "seller.address_phone",
    "seller.bank_account",
    "密码区"
  ],
  "fields": {
    "invoice_number": {
      "type": "string",
      "required": true,
      "label": "发票号码（20 位）"
    },
    "issue_date": {
      "type": "string",
      "required": false,
      "label": "开票日期"
    },
    "buyer_name": {
      "type": "string",
      "required": false,
      "label": "购买方名称"
    },
    "buyer_tax_id": {
      "type": "string",
      "required": false,
      "label": "购买方统一社会信用代码"
    },
    "seller_name": {
      "type": "string",
      "required": false,
      "label": "销售方名称"
    },
    "seller_tax_id": {
      "type": "string",
      "required": false,
      "label": "销售方统一社会信用代码"
    },
    "total_excl_tax": {
      "type": "string",
      "required": false,
      "label": "合计金额"
    },
    "total_tax": {
      "type": "string",
      "required": false,
      "label": "合计税额"
    },
    "total_incl_tax": {
      "type": "string",
      "required": false,
      "label": "价税合计"
    },
    "remarks": {
      "type": "string",
      "required": false,
      "label": "备注"
    }
  }
}
