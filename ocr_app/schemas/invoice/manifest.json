{
  "id": "invoice",
  "title": "增值税发票",
  "version": "1.0.0",
  "kind": "builtin",
  "entry": "__init__.py",
  "priority": 100,
  "layout": "html_layout.py",
  "detect": {
    "keywords": ["增值税", "发票", "价税合计", "纳税人识别号"],
    "note": "detect 恒真，票种判定在 extract 内依据版面证据完成"
  },
  "fields": [
    "header.invoice_code", "header.invoice_number", "header.issue_date",
    "buyer.name", "buyer.tax_id", "buyer.address_phone", "buyer.bank_account",
    "seller.name", "seller.tax_id", "seller.address_phone", "seller.bank_account",
    "items[].name", "items[].spec", "items[].unit", "items[].quantity",
    "items[].unit_price", "items[].amount", "items[].tax_rate", "items[].tax_amount",
    "totals.total_excl_tax", "totals.total_tax",
    "total_incl_tax.capital", "total_incl_tax.figures",
    "remarks", "signatures.payee", "signatures.reviewer", "signatures.issuer"
  ]
}
